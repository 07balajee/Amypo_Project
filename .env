# `mysql` runs the bundled MySQL container. To use MySQL installed on this PC instead, drop `mysql`
# from the list and set DB_HOST=host.docker.internal (and DB_USER/DB_PASSWORD for that server).
COMPOSE_PROFILES=router,qa,mysql

# Local-only credentials for the bundled MySQL container (internal network, no egress).
# Change them before running anywhere shared.
DB_HOST=mysql
DB_USER=amypo
DB_PASSWORD=amypo_local_dev
MYSQL_ROOT_PASSWORD=amypo_root_local_dev
